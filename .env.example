# Copia este archivo como .env.local para configurar el catálogo.
#
# Clave de TMDB: sirve el "Token de acceso de lectura a la API" (recomendado)
# o la "Clave de la API". https://www.themoviedb.org/settings/api
VITE_TMDB_TOKEN=
#
# Fuente de datos (opcional):
#   (vacío) → TMDB si hay clave; si no, modo demo
#   demo    → APIs gratuitas sin clave (series de TVmaze + películas de iTunes)
#   local   → el catálogo escrito a mano en src/data/titles.ts
VITE_CATALOG=
